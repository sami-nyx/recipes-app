tests/

# Lint/type-checker caches
.mypy_cache/
.ruff_cache/

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo

# Docker / Compose Files
docker-compose*.yaml
docker-compose*.yml
Dockerfile
.dockerignore

# Documentation & Markdown
README.md

# Logs
*.log
